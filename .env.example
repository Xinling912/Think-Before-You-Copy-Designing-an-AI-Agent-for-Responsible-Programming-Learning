# Copy this file to .env and replace the placeholder locally.
# Never commit the populated .env file.
DASHSCOPE_API_KEY=replace_with_your_own_key

# Optional settings
DASHSCOPE_CHAT_MODEL=qwen3.7-max
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_EMBED_DIM=1024
DASHSCOPE_RERANK_MODEL=qwen3-rerank
APP_MODE=development
REA_PORT=18081

